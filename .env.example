# Copia este archivo como .env y ajusta los valores.

# Endpoint de envío del formulario de contacto.
# Acepta cualquier servicio que reciba POST JSON:
#   - Formspree:   https://formspree.io/f/tu-id
#   - Web3Forms:   https://api.web3forms.com/submit
#   - Backend propio
# Déjalo vacío para que el formulario abra el cliente de correo (mailto:) con el
# mensaje precargado hacia el email definido en src/data/mock.js.
REACT_APP_CONTACT_ENDPOINT=

# Puerto del dev server
PORT=3003
WDS_SOCKET_PORT=443

# Endpoints de salud del plugin (solo desarrollo; mantener false en producción)
ENABLE_HEALTH_CHECK=false

# No generar sourcemaps: el build se publica en docs/ y expondría el código fuente
GENERATE_SOURCEMAP=false
