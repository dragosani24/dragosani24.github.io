# Endpoint de envío del formulario de contacto (Formspree, Web3Forms, backend propio...).
# Vacío = el formulario abre el cliente de correo (mailto:) con el mensaje precargado.
REACT_APP_CONTACT_ENDPOINT=
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false
PORT=3003
# No generar sourcemaps: el build se publica en docs/ y expondría el código fuente
GENERATE_SOURCEMAP=false